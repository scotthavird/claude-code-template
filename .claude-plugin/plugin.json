{
  "$schema": "https://json.schemastore.org/claude-code-plugin.json",
  "name": "dev-starter-kit",
  "displayName": "Claude Code Template",
  "version": "0.4.0",
  "description": "An opinionated Claude Code starter kit: slash commands, subagents, auto-triggered skills, output styles, a theme, MCP servers, and a plugin bin/ helper.",
  "author": {
    "name": "Scott Havird",
    "url": "https://github.com/scotthavird"
  },
  "homepage": "https://github.com/scotthavird/claude-code-template",
  "repository": "https://github.com/scotthavird/claude-code-template",
  "license": "MIT",
  "keywords": [
    "template",
    "starter",
    "devcontainer",
    "hooks",
    "skills",
    "subagents",
    "themes"
  ],
  "engines": {
    "claude-code": ">=2.1.323"
  },
  "commands": "./.claude/commands",
  "agents": [
    "./.claude/agents/debugger.md",
    "./.claude/agents/dependency-auditor.md",
    "./.claude/agents/doc-generator.md",
    "./.claude/agents/pr-reviewer.md",
    "./.claude/agents/refactor-planner.md",
    "./.claude/agents/security-auditor.md",
    "./.claude/agents/test-runner.md"
  ],
  "skills": "./.claude/skills",
  "outputStyles": [
    "./.claude/output-styles/concise.md",
    "./.claude/output-styles/educational.md",
    "./.claude/output-styles/review.md"
  ],
  "experimental": {
    "themes": "./.claude/themes/anthropic-clay.json"
  }
}
