{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": [
    "schema/**/*.ts",
    "recorder/src/**/*.ts",
    "studio/**/*.ts",
    "studio/**/*.tsx",
    "docs-gen/src/**/*.ts"
  ]
}
